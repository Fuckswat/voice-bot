# --- обязательное ---
BOT_TOKEN=123456:ABC-DEF_твой_токен_от_BotFather

# --- ollama ---
OLLAMA_MODEL=saiga
OLLAMA_HOST=http://127.0.0.1:11434
LLM_TIMEOUT=90
LLM_MAX_INPUT_CHARS=6000

# --- whisper ---
# размер модели (tiny/base/small/medium/large-v3) ИЛИ путь к папке с весами
WHISPER_MODEL=medium
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5
# auto (пусто) | cpu | cuda — пусто = детект по nvidia-smi, при ошибке откат на cpu/int8
WHISPER_DEVICE=
# по умолчанию float16 для cuda и int8 для cpu
WHISPER_COMPUTE_TYPE=
# сколько распознаваний крутить одновременно; 1 = очередь (одна модель не потокобезопасна)
STT_CONCURRENCY=1
# 0 = не греть модель на старте (грузится при первом гс)
WHISPER_WARMUP=1

# --- хранилище ---
DB_PATH=transcripts.db
TRANSCRIPT_TTL_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600

# --- прочее ---
# кому слать «бот поднялся» при старте (свой chat_id; пусто = не слать)
NOTIFY_CHAT_ID=
LONG_VOICE_SECONDS=120
LOG_LEVEL=INFO
# TMP_DIR=  # по умолчанию системный temp
